# ---------------------------------------------------------------------------
# Storage — Postgres holds everything (users, rules, overrides, AI reviews,
# transaction cache, FX rates, sessions). Railway's Postgres plugin injects
# DATABASE_URL automatically; set it yourself for local dev.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://localhost:5432/tallyhouse
# PGSSL=disable   # set when connecting to a local Postgres without TLS

# Encrypts each user's stored Lunchflow/OpenAI keys at rest. 32 random bytes,
# base64. Generate with:  openssl rand -base64 32
ENCRYPTION_KEY=

# Random string used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where the footer's "running <commit>" link points. Left unset it is the GitHub
# repo Railway built this deployment from, which is what makes the claim
# checkable — set it only for a source Railway cannot name (a mirror, a private
# host), or set it empty to state the commit without linking it anywhere.
# SOURCE_REPO_URL=https://github.com/you/tallyhouse

# ---------------------------------------------------------------------------
# Sign-in — Google OAuth. Any Google account can sign up; on first login the
# user is sent to onboarding to provide their own Lunchflow + OpenAI keys.
# Create a Web-application OAuth client at
# https://console.cloud.google.com/apis/credentials and register the redirect
# URI  <origin>/auth/google/callback  (e.g. https://your-app/auth/google/callback
# and http://localhost:3000/auth/google/callback for local testing).
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: pin the callback URL instead of deriving it from the request.
# GOOGLE_REDIRECT_URI=https://your-app/auth/google/callback

# How many accounts this instance will create, default 20. Existing accounts are
# never affected — the cap only refuses first-time sign-ins, which are offered a
# waiting list instead. 0 (or anything unparseable) means no limit.
# The binding resource is memory: each account's transaction pull is cached
# in-process and never evicted, and one replica sweeps all of them hourly.
# MAX_USERS=20

# ---------------------------------------------------------------------------
# Per-user API keys are entered at onboarding — the app no longer reads global
# Lunchflow/OpenAI keys. These OpenAI tuning knobs still apply to every user's
# reviews. Pricing overrides feed the spend estimate shown in settings.
# ---------------------------------------------------------------------------
# YOUR key, and the one exception to the rule above. Used for exactly one call:
# proposing a starting category list for an account that set up without an
# OpenAI key of its own (the AI review is then off for them). Once per account,
# asked for rather than assumed, and not counted as that account's spend.
# Leave it unset and the offer is never made. Not called OPENAI_API_KEY on
# purpose — this should only ever be on because you chose to pay for it.
# ONBOARDING_OPENAI_KEY=sk-...
#
# OPENAI_MODEL=gpt-5.4-mini          # any Responses-API model
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_REASONING_EFFORT=low        # low = fast/cheap; try medium if verdicts feel shallow
# OPENAI_CONCURRENCY=2               # concurrent OpenAI calls per API key
#
# The next two are only defaults for accounts that have never chosen. Setup asks
# for both, Settings -> AI review edits them, and a stored answer always wins.
# OPENAI_SWEEP_MONTHS=12             # calendar months the sweep covers (setup offers 1)
# OPENAI_WEB_SEARCH=0                # merchant web search off by default (it is most
#                                    # of the ~1c a review costs, and the only part
#                                    # that sends merchant names to a search engine)
#
# What one review is expected to cost, for the estimate shown before any have run:
# measured averages, not a calculation from the token prices above.
# OPENAI_EST_TOKENS_PER_REVIEW=0.0025    # USD of tokens per review
# OPENAI_EST_SEARCHES_PER_REVIEW=0.75    # how often the merchant search actually fires
#
# OPENAI_SWEEP_LIGHT=1               # light mode: sweep only the 10 most recent "Other"
# SWEEP_INTERVAL_MINUTES=60          # background sweep cadence (default 60, 0 = off).
#                                    # Needs a single replica.

# ---------------------------------------------------------------------------
# Local dev
# ---------------------------------------------------------------------------
# PORT=3000
# CACHE_TTL_MINUTES=15
# MOCK_REVIEWS=1     # real data, but AI reviews are the free deterministic mock
# MOCK_DATA=1        # serve generated demo data; skips key validation at onboarding
#                    # and enables the dev email login when Google isn't configured
